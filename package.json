{
  "name": "narwhalapi",
  "version": "0.1.0",
  "description": "Typed server-side client for the Narwhal API",
  "type": "module",
  "author": "Narwhal API Team <support@narwhalapi.com>",
  "homepage": "https://narwhalapi.com",
  "license": "MIT",
  "keywords": [
    "api",
    "sdk",
    "economics",
    "fx",
    "exchange-rates",
    "inflation",
    "holidays",
    "palm-oil",
    "decimal"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && biome check . && vitest run",
    "test": "vitest run",
    "prepack": "npm run build",
    "smoke": "npm run build && node test/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "sideEffects": false
}
